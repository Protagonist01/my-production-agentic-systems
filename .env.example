# H1 reads selected values from ignored .env.local. The offline example reads no credentials.
# Use an absolute directory outside the repository for raw source snapshots.
PRODUCTION_AGENTS_DATA_DIR=
# H1 selected Gemini Developer API on the free tier. No Vertex/billing fallback.
# Copy these placeholders to .env.local; confirm the AI Studio project is Free.
GEMINI_API_KEY=
GEMINI_FREE_TIER_CONFIRMED=false
# Configure isolated services under F4.
DATABASE_URL=
# Use a dedicated project on the existing local Langfuse instance.
# Put its key pair and localhost base URL in ignored .env.local.
# H8 telemetry-check sends invented offline data; see docs/telemetry.md.
# H1 trace-check retains its live-model smoke behavior.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
